{
  "openapi": "3.1.0",
  "info": {
    "title": "X-Road simulé — administrations, dossiers et agents",
    "version": "1.1.0",
    "description": "Simulation déclarée : aucune réponse ne vient d’une vraie administration. Voir docs/xroad-sim.md."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4040",
      "description": "Simulation locale"
    }
  ],
  "paths": {
    "/v1/administrations": {
      "get": {
        "operationId": "listXroadAdministrations",
        "summary": "listXroadAdministrations",
        "description": "Administrations de la simulation, connectées ou non.",
        "parameters": [
          {
            "name": "traceparent",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-0[01]$"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdministrationPage"
                }
              }
            }
          },
          "default": {
            "description": "Erreur RFC 9457 ; voir CONTRACTS.md pour les codes HTTP",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-role": "xroad:read"
      }
    },
    "/v1/procedures": {
      "get": {
        "operationId": "searchXroadProcedures",
        "summary": "searchXroadProcedures",
        "description": "Catalogue des démarches. `query` cherche dans le titre et le résumé ; `administrationId` filtre par administration.",
        "parameters": [
          {
            "name": "traceparent",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-0[01]$"
            }
          },
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "administrationId",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/AdministrationId"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
