    "/v1/cases": {
      "post": {
        "operationId": "createXroadCase",
        "summary": "createXroadCase",
        "description": "Dépôt d'un dossier pour l'usager `X-Applicant-Ref`. L'administration cible est celle de la démarche. 201 avec `awaiting_payment` si la démarche a des frais, sinon `received`. Même `requestId` déjà déposé : 409.",
        "parameters": [
          {
            "name": "traceparent",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-0[01]$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          },
          {
            "name": "X-Applicant-Ref",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UserRef"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dossier déposé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Case"
                }
              }
            }
          },
          "default": {
            "description": "Erreur RFC 9457 ; voir CONTRACTS.md pour les codes HTTP",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-role": "xroad:submit"
      },
      "get": {
        "operationId": "listXroadCases",
        "summary": "listXroadCases",
        "description": "Dossiers visibles par l'agent `X-Official-Id`. `view=pending` : `in_review` ; `view=completed` : `completed`. Plus ancien en premier pour `pending`, plus récent en premier sinon.",
        "parameters": [
          {
            "name": "traceparent",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-0[01]$"
            }
          },
          {
            "name": "X-Official-Id",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OfficialId"
            }
          },
          {
            "name": "administrationId",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/AdministrationId"
            }
          },
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "completed",
                "all"
              ],
              "default": "all"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CasePage"
                }
              }
            }
          },
          "default": {
            "description": "Erreur RFC 9457 ; voir CONTRACTS.md pour les codes HTTP",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-role": "xroad:administer"
      }
    },
