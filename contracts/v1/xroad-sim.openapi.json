        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcedurePage"
                }
              }
            }
          },
          "default": {
            "description": "Erreur RFC 9457 ; voir CONTRACTS.md pour les codes HTTP",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-role": "xroad:read"
      }
    },
