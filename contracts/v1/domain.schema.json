    "McpAuth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "secretRef"
          ],
          "properties": {
            "type": {
              "const": "bearer"
            },
            "secretRef": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,200}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "headers"
          ],
          "properties": {
            "type": {
              "const": "headers"
            },
            "headers": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 16,
              "propertyNames": {
                "pattern": "^[-A-Za-z0-9]+$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,200}$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "tokenUrl",
            "clientId",
            "clientSecretRef"
          ],
          "properties": {
            "type": {
              "const": "oauth-client-credentials"
            },
            "tokenUrl": {
              "type": "string",
              "format": "uri"
            },
            "clientId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "clientSecretRef": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,200}$"
            },
            "scope": {
              "type": "string",
              "maxLength": 1000
            },
            "audience": {
              "type": "string",
              "maxLength": 1000
            }
          }
        }
      ]
    },
    "McpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
