{
  "openapi": "3.1.0",
  "info": {
    "title": "C1 — Récepteur rappel WhatsApp",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4030",
      "description": "Simulation locale uniquement"
    }
  ],
  "paths": {
    "/v1/callbacks/events": {
      "post": {
        "operationId": "deliverWhatsAppEvent",
        "summary": "Recevoir message.sent pour WhatsApp",
        "parameters": [
          {
            "name": "traceparent",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-0[01]$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Événement enregistré ou déjà reçu"
          },
          "default": {
            "description": "Erreur RFC 9457 ; voir CONTRACTS.md pour les codes HTTP",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Event"
              }
            }
          }
        },
        "x-role": "messages:deliver"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ConversationId": {
        "type": "string",
        "pattern": "^cnv_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "UserRef": {
        "type": "string",
        "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "MessageId": {
        "type": "string",
        "pattern": "^msg_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "RequestId": {
        "type": "string",
        "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "FileId": {
        "type": "string",
        "pattern": "^fil_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "MandateId": {
        "type": "string",
        "pattern": "^mdt_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "ChallengeId": {
        "type": "string",
        "pattern": "^chl_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "EventId": {
        "type": "string",
        "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "Locale": {
        "type": "string",
        "enum": [
          "fr",
          "fon",
          "yo"
        ]
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "IDEMPOTENCY_CONFLICT",
              "MANDATE_MISSING",
              "MANDATE_EXPIRED",
              "MANDATE_REVOKED",
              "MANDATE_SCOPE_DENIED",
              "REQUEST_INCOMPLETE",
              "INVALID_TRANSITION",
              "UPSTREAM_UNAVAILABLE",
              "RATE_LIMITED",
              "UNSUPPORTED_MEDIA_TYPE",
              "FILE_TOO_LARGE",
              "REPLAY_EXPIRED"
            ]
          },
          "traceId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "traceId"
        ]
      },
      "Source": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "procedureId": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "procedureId",
          "url",
          "retrievedAt",
          "version"
        ]
      },
      "RequestStatus": {
        "type": "string",
        "enum": [
          "draft",
          "ready",
          "awaiting_user_validation",
          "submitted",
          "processing",
          "completed",
          "rejected",
          "cancelled"
