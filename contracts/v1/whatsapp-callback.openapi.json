        "properties": {
          "id": {
            "$ref": "#/components/schemas/MandateId"
          },
          "conversationId": {
            "$ref": "#/components/schemas/ConversationId"
          },
          "userRef": {
            "$ref": "#/components/schemas/UserRef"
          },
          "procedureId": {
            "type": "string",
            "minLength": 1
          },
          "scopes": {
            "type": "array",
