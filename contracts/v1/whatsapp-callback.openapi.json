          },
          "processingDays": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "validationStatus": {
            "type": "string",
            "enum": [
              "draft",
              "validated"
            ]
          },
          "formSchema": {
            "type": "object",
            "additionalProperties": true
