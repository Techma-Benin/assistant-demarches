{
  "openapi": "3.1.0",
  "info": {
    "title": "Interne — Backend → Tooling (mandats)",
    "version": "2.3.0",
    "description": "Jeton de service Keycloak du client backend (azp = backend, audience techma-tooling, scope mandates:grant). Le serveur MCP n’accepte pas ce scope comme appel d’outil."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4030",
      "description": "Poste local (pnpm dev)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/internal/v1/mandates": {
      "post": {
        "operationId": "createMandate",
        "summary": "Enregistrer un mandat après clic de l’usager",
        "description": "Le Tooling vérifie le proofToken (JWKS du Backend, audience techma-mandate, jti = challenge.id), consomme le challenge une seule fois et crée le mandat (1 h).",
        "tags": [
          "Mandats"
        ],
        "parameters": [
          {
            "name": "traceparent",
            "in": "header",
            "required": false,
            "description": "W3C Trace Context. Facultatif : le serveur en crée un s’il est absent.",
            "schema": {
              "type": "string",
              "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-0[01]$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Clé de 8 à 128 caractères. Même clé + même corps = même réponse pendant 24 h ; corps différent = 409 IDEMPOTENCY_CONFLICT.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MandateGrant"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Succès.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mandate"
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide (INVALID_REQUEST).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Authentification absente ou invalide (UNAUTHORIZED).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Droit insuffisant (FORBIDDEN).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflit d’état (CONFLICT, INVALID_TRANSITION, IDEMPOTENCY_CONFLICT).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Dépendance indisponible (UPSTREAM_UNAVAILABLE), avec Retry-After.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/mandates/{mandateId}/revoke": {
      "post": {
        "operationId": "revokeMandateInternal",
        "summary": "Révoquer un mandat",
        "tags": [
          "Mandats"
        ],
        "parameters": [
          {
            "name": "traceparent",
            "in": "header",
            "required": false,
            "description": "W3C Trace Context. Facultatif : le serveur en crée un s’il est absent.",
            "schema": {
              "type": "string",
              "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-0[01]$"
            }
          },
          {
            "name": "mandateId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/MandateId"
            }
          },
          {
            "name": "X-User-Ref",
            "in": "header",
            "required": true,
            "description": "Usager propriétaire.",
            "schema": {
              "$ref": "#/components/schemas/UserRef"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Clé de 8 à 128 caractères. Même clé + même corps = même réponse pendant 24 h ; corps différent = 409 IDEMPOTENCY_CONFLICT.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succès.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mandate"
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide (INVALID_REQUEST).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Authentification absente ou invalide (UNAUTHORIZED).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Droit insuffisant (FORBIDDEN).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Ressource absente ou hors de portée (NOT_FOUND).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Dépendance indisponible (UPSTREAM_UNAVAILABLE), avec Retry-After.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Challenge": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ChallengeId"
          },
          "conversationId": {
            "$ref": "#/components/schemas/ConversationId"
          },
          "userRef": {
            "$ref": "#/components/schemas/UserRef"
          },
          "procedureId": {
            "$ref": "#/components/schemas/ProcedureId"
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Scope"
            }
          },
          "consentText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Texte affiché tel quel par l’Interface."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "proofToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "JWT RS256 signé par le Backend, opaque pour l’Interface et le modèle."
          }
        },
        "required": [
          "id",
          "conversationId",
          "userRef",
          "procedureId",
          "scopes",
          "consentText",
          "expiresAt",
          "proofToken"
        ]
      },
      "ChallengeId": {
        "type": "string",
        "pattern": "^chl_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "ConversationId": {
        "type": "string",
        "pattern": "^cnv_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "Mandate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/MandateId"
          },
          "conversationId": {
            "$ref": "#/components/schemas/ConversationId"
          },
          "userRef": {
            "$ref": "#/components/schemas/UserRef"
          },
          "procedureId": {
            "$ref": "#/components/schemas/ProcedureId"
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Scope"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "revoked",
              "expired"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "conversationId",
          "userRef",
          "procedureId",
          "scopes",
          "status",
          "expiresAt"
        ]
      },
      "MandateGrant": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "$ref": "#/components/schemas/Challenge"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "evidenceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "challenge",
          "acceptedAt",
          "evidenceRef"
        ]
      },
      "MandateId": {
        "type": "string",
        "pattern": "^mdt_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "LOGIN_REQUIRED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "IDEMPOTENCY_CONFLICT",
              "MANDATE_MISSING",
              "MANDATE_EXPIRED",
              "MANDATE_REVOKED",
              "MANDATE_SCOPE_DENIED",
              "REQUEST_INCOMPLETE",
              "INVALID_TRANSITION",
              "NOT_ASSISTED",
              "REPLAY_EXPIRED",
              "UNSUPPORTED_MEDIA_TYPE",
              "FILE_TOO_LARGE",
              "RATE_LIMITED",
              "UPSTREAM_UNAVAILABLE",
              "MCP_AUTH_FAILED",
              "MCP_CONNECTION_FAILED",
              "MCP_DISCOVERY_FAILED"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "traceId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "traceId"
        ]
      },
      "ProcedureId": {
        "type": "string",
        "pattern": "^PS[0-9]{5}$",
        "description": "Identifiant officiel de la fiche sur service-public.bj."
      },
      "Scope": {
        "type": "string",
        "enum": [
          "requests:write",
          "documents:write",
          "requests:submit"
        ]
      },
      "UserRef": {
        "type": "string",
        "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
        "description": "Référence opaque de l’usager, attribuée par le Backend. Jamais fournie par le navigateur ni par le modèle."
      }
    }
  }
}
