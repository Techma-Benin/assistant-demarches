{
  "version": "2.3.0",
  "description": "Catalogue du serveur MCP Techma (Streamable HTTP, POST /mcp). Les schémas $ref sont résolus depuis domain.schema.json par contracts:sync dans la copie embarquée $defs.",
  "context": {
    "headers": {
      "X-Conversation-Id": "Conversation en cours (obligatoire pour tools/call).",
      "X-User-Ref": "Usager (obligatoire pour tools/call). Construit par le code du Backend, jamais par le modèle.",
      "X-Channel": "web ou whatsapp (obligatoire pour request.submit).",
      "X-Mandate-Id": "Mandat actif (obligatoire pour les actions).",
      "Idempotency-Key": "Obligatoire pour les actions ; stable pour une même tentative."
    },
    "discovery": "initialize et tools/list sont permis sans en-tête de contexte (ajout du serveur par URL). tools/call sans contexte : erreur INVALID_REQUEST.",
    "errors": "Erreur métier : isError true et bloc texte JSON {code, detail, traceId} (codes de Problem)."
  },
  "tools": [
    {
      "name": "procedures.search",
      "description": "Recherche classée dans le catalogue officiel (service-public.bj via le X-Road simulé). Retourne au plus 5 fiches.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "bj.techma/kind": "read",
        "bj.techma/requiresMandate": false,
        "bj.techma/requiresLogin": false,
        "bj.techma/scopes": []
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Procedure"
            }
          }
        },
        "required": [
          "items"
        ]
      }
    },
    {
      "name": "procedures.get",
      "description": "Fiche officielle complète, avec filing si l’assistant peut déposer.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "bj.techma/kind": "read",
        "bj.techma/requiresMandate": false,
        "bj.techma/requiresLogin": false,
        "bj.techma/scopes": []
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "procedureId": {
            "$ref": "#/$defs/ProcedureId"
          }
        },
        "required": [
          "procedureId"
        ]
      },
      "outputSchema": {
        "$ref": "#/$defs/Procedure"
      }
    },
    {
      "name": "request.create",
      "description": "Ouvre un brouillon pour une démarche déposable. NOT_ASSISTED si filing est null. Connexion requise.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "bj.techma/kind": "action",
        "bj.techma/requiresMandate": true,
        "bj.techma/requiresLogin": true,
        "bj.techma/scopes": [
          "requests:write"
        ]
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "procedureId": {
            "$ref": "#/$defs/ProcedureId"
          }
        },
        "required": [
          "procedureId"
        ]
      },
      "outputSchema": {
        "$ref": "#/$defs/Request"
      }
    },
    {
      "name": "request.update",
      "description": "Renseigne des champs du brouillon (formSchema de la démarche). source précise la provenance affichée.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "bj.techma/kind": "action",
        "bj.techma/requiresMandate": true,
        "bj.techma/requiresLogin": true,
        "bj.techma/scopes": [
          "requests:write"
        ]
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "$ref": "#/$defs/RequestId"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "answer",
                    "document"
                  ]
                }
              },
              "required": [
                "name",
                "value",
                "source"
              ]
            }
          }
        },
        "required": [
          "requestId",
          "fields"
        ]
      },
      "outputSchema": {
        "$ref": "#/$defs/Request"
      }
    },
    {
      "name": "documents.attach",
      "description": "Rattache une pièce déjà déposée par l’usager (fileId) à un type de pièce requis. Le contenu n’est jamais lu.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "bj.techma/kind": "action",
        "bj.techma/requiresMandate": true,
        "bj.techma/requiresLogin": true,
        "bj.techma/scopes": [
          "documents:write"
        ]
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "$ref": "#/$defs/RequestId"
          },
          "documentType": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$"
          },
          "fileId": {
            "$ref": "#/$defs/FileId"
          }
        },
        "required": [
          "requestId",
          "documentType",
          "fileId"
        ]
      },
      "outputSchema": {
        "$ref": "#/$defs/Request"
      }
    },
    {
      "name": "request.submit",
      "description": "Dépose le dossier dans le X-Road simulé (pièces transmises). REQUEST_INCOMPLETE si missing n’est pas vide.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "bj.techma/kind": "action",
        "bj.techma/requiresMandate": true,
        "bj.techma/requiresLogin": true,
        "bj.techma/scopes": [
          "requests:submit"
        ]
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "$ref": "#/$defs/RequestId"
          }
        },
        "required": [
          "requestId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request": {
            "$ref": "#/$defs/Request"
          },
          "case": {
            "$ref": "#/$defs/Case"
          }
        },
        "required": [
          "request",
          "case"
        ]
      }
    },
    {
      "name": "request.pay",
      "description": "Paiement simulé des frais d’un dossier en awaiting_payment.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "bj.techma/kind": "action",
        "bj.techma/requiresMandate": true,
        "bj.techma/requiresLogin": true,
        "bj.techma/scopes": [
          "requests:submit"
        ]
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "$ref": "#/$defs/RequestId"
          }
        },
        "required": [
          "requestId"
        ]
      },
      "outputSchema": {
        "$ref": "#/$defs/Case"
      }
    },
    {
      "name": "case.status",
      "description": "État à jour d’un dossier déposé par l’usager.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "bj.techma/kind": "read",
        "bj.techma/requiresMandate": false,
        "bj.techma/requiresLogin": true,
        "bj.techma/scopes": []
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "$ref": "#/$defs/RequestId"
          }
        },
        "required": [
          "requestId"
        ]
      },
      "outputSchema": {
        "$ref": "#/$defs/Case"
      }
    },
    {
      "name": "case.respond",
      "description": "Répond à une demande de complément de l’administration (message, champs, pièces).",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "bj.techma/kind": "action",
        "bj.techma/requiresMandate": true,
        "bj.techma/requiresLogin": true,
        "bj.techma/scopes": [
          "requests:submit"
        ]
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "$ref": "#/$defs/RequestId"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "fileIds": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "documentType": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{1,62}$"
                },
                "fileId": {
                  "$ref": "#/$defs/FileId"
                }
              },
              "required": [
                "documentType",
                "fileId"
              ]
            }
          }
        },
        "required": [
          "requestId",
          "message",
          "fields",
          "fileIds"
        ]
      },
      "outputSchema": {
        "$ref": "#/$defs/Case"
      }
    }
  ],
  "$defs": {
    "AdministrationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "description": "Identifiant stable d’une administration du X-Road simulé (ex. justice, anip)."
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/CaseId"
        },
        "reference": {
          "type": "string",
          "pattern": "^SIM-[A-Z]{2,5}-[0-9]{4}-[0-9]{6}$"
        },
        "simulated": {
          "const": true
        },
        "procedureId": {
          "$ref": "#/$defs/ProcedureId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "administrationId": {
          "$ref": "#/$defs/AdministrationId"
        },
        "applicantRef": {
          "$ref": "#/$defs/UserRef"
        },
        "requestId": {
          "$ref": "#/$defs/RequestId"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "status": {
          "$ref": "#/$defs/CaseStatus"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "description": "Valeurs du formulaire de la démarche, conformes à Procedure.filing.formSchema."
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaseDocument"
          }
        },
        "payment": {
          "$ref": "#/$defs/CasePayment"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CaseStep"
          }
        },
        "informationRequest": {
          "anyOf": [
            {
              "$ref": "#/$defs/InformationRequest"
            },
            {
              "type": "null"
            }
          ],
          "description": "Renseigné tant que status = information_requested."
        },
        "claimedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/OfficialId"
            },
            {
              "type": "null"
            }
          ]
        },
        "completedBy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "assistant",
            "administration",
            null
          ]
        },
        "decisionNote": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "reference",
        "simulated",
        "procedureId",
        "title",
        "administrationId",
        "applicantRef",
        "requestId",
        "channel",
        "status",
        "fields",
        "documents",
        "payment",
        "steps",
        "informationRequest",
        "claimedBy",
        "completedBy",
        "decisionNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "CaseDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/DocumentId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "submitted",
            "issued"
          ],
          "description": "submitted = pièce de l’usager ; issued = document délivré par l’administration (simulation)."
        },
        "documentType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mimeType": {
          "type": "string",
          "enum": [
            "application/pdf",
            "image/jpeg",
            "image/png"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "kind",
        "documentType",
        "name",
        "mimeType",
        "sizeBytes",
        "createdAt"
      ]
    },
    "CaseId": {
      "type": "string",
      "pattern": "^cas_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "CasePayment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amountFcfa": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "paid"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "paidAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "simulated": {
          "const": true
        }
      },
      "required": [
        "amountFcfa",
        "status",
        "reference",
        "paidAt",
        "simulated"
      ]
    },
    "CaseStatus": {
      "type": "string",
      "enum": [
        "awaiting_payment",
        "received",
        "in_review",
        "information_requested",
        "completed",
        "rejected"
      ]
    },
    "CaseStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "state": {
          "type": "string",
          "enum": [
            "done",
            "blocked",
            "pending"
          ]
        },
        "actor": {
          "type": "string",
          "enum": [
            "assistant",
            "applicant",
            "administration"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "label",
        "state",
        "actor",
        "note",
        "at"
      ]
    },
    "Channel": {
      "type": "string",
      "enum": [
        "web",
        "whatsapp"
      ]
    },
    "ConversationId": {
      "type": "string",
      "pattern": "^cnv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "DocumentId": {
      "type": "string",
      "pattern": "^doc_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "FileId": {
      "type": "string",
      "pattern": "^fil_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Filing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Cas couverts par le dépôt via l’assistant ; les autres cas suivent la fiche officielle."
        },
        "formSchema": {
          "type": "object",
          "description": "JSON Schema 2020-12 des champs du dossier."
        },
        "requiredDocuments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequiredDocument"
          }
        },
        "feeFcfa": {
          "type": "integer",
          "minimum": 0
        },
        "processingDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "scope",
        "formSchema",
        "requiredDocuments",
        "feeFcfa",
        "processingDays"
      ]
    },
    "InformationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "requestedBy": {
          "$ref": "#/$defs/OfficialId"
        }
      },
      "required": [
        "note",
        "requestedAt",
        "requestedBy"
      ]
    },
    "OfficialId": {
      "type": "string",
      "pattern": "^off_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Procedure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ProcedureId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "administrationId": {
          "$ref": "#/$defs/AdministrationId"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "feeFcfa": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Montant unique publié par la fiche, sinon null (voir inPerson/online)."
        },
        "processingDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "inPerson": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fee": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "delay": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "documents": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "process": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "where": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                }
              },
              "required": [
                "fee",
                "delay",
                "documents",
                "process",
                "where",
                "url"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Texte officiel du canal « sur place », sans réécriture."
        },
        "online": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fee": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "delay": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "documents": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "process": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "where": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                }
              },
              "required": [
                "fee",
                "delay",
                "documents",
                "process",
                "where",
                "url"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Texte officiel du canal « en ligne », sans réécriture."
        },
        "hours": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "filing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Filing"
            },
            {
              "type": "null"
            }
          ],
          "description": "Présent si l’assistant peut déposer le dossier ; null = information seulement."
        }
      },
      "required": [
        "id",
        "title",
        "administrationId",
        "summary",
        "target",
        "authority",
        "feeFcfa",
        "processingDays",
        "inPerson",
        "online",
        "hours",
        "source",
        "filing"
      ]
    },
    "ProcedureId": {
      "type": "string",
      "pattern": "^PS[0-9]{5}$",
      "description": "Identifiant officiel de la fiche sur service-public.bj."
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "conversationId": {
          "$ref": "#/$defs/ConversationId"
        },
        "procedureId": {
          "$ref": "#/$defs/ProcedureId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "administrationId": {
          "$ref": "#/$defs/AdministrationId"
        },
        "status": {
          "$ref": "#/$defs/RequestStatus"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequestField"
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequestDocument"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": "Champs et pièces encore requis avant dépôt."
        },
        "caseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "conversationId",
        "procedureId",
        "title",
        "administrationId",
        "status",
        "fields",
        "documents",
        "missing",
        "caseId",
        "updatedAt"
      ]
    },
    "RequestDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fileId": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "documentType",
        "label",
        "fileId"
      ]
    },
    "RequestField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "answer",
            "document",
            null
          ],
          "description": "Provenance affichée dans le panneau « vos informations »."
        }
      },
      "required": [
        "name",
        "label",
        "value",
        "source"
      ]
    },
    "RequestId": {
      "type": "string",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "RequestStatus": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "submitted",
        "cancelled"
      ],
      "description": "Brouillon côté Tooling. Après submitted, l’état fait foi dans le dossier X-Road (caseId)."
    },
    "RequiredDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "acceptedMimeTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "application/pdf",
              "image/jpeg",
              "image/png"
            ]
          }
        }
      },
      "required": [
        "documentType",
        "label",
        "acceptedMimeTypes"
      ]
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "procedureId": {
          "$ref": "#/$defs/ProcedureId"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Fiche publique sur service-public.bj."
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Date de collecte de la fiche."
        }
      },
      "required": [
        "procedureId",
        "url",
        "retrievedAt"
      ]
    },
    "UserRef": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Référence opaque de l’usager, attribuée par le Backend. Jamais fournie par le navigateur ni par le modèle."
    }
  }
}
