  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Administration": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/AdministrationId"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "shortName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "themes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": "Thèmes affichés à l’accueil usager."
          },
          "connection": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "connected",
                  "not_connected"
                ]
              },
              "since": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "required": [
              "status",
              "since"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "shortName",
          "themes",
          "connection"
        ]
      },
      "AdministrationId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,62}$",
        "description": "Identifiant stable d’une administration du X-Road simulé (ex. justice, anip)."
      },
      "McpAuth": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "none"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "bearer"
              },
              "secretRef": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,100}$"
              }
            },
            "required": [
              "type",
              "secretRef"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "oauth-client-credentials"
              },
              "tokenUrl": {
                "type": "string",
                "format": "uri"
              },
              "clientId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "clientSecretRef": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,100}$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              }
            },
            "required": [
              "type",
              "tokenUrl",
              "clientId",
              "clientSecretRef",
              "scope"
            ]
          }
        ]
      },
      "McpServer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "enabled": {
            "type": "boolean"
          },
          "auth": {
            "$ref": "#/components/schemas/McpAuth"
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "enabled",
          "auth"
        ]
      },
      "McpServerPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/McpServer"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Curseur opaque de la page suivante ; null en fin de liste."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "McpTool": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "serverId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string"
          },
          "inputSchema": {
            "type": "object"
          },
          "enabled": {
            "type": "boolean",
            "description": "Désactivé par défaut après découverte."
          },
          "requiresMandate": {
            "type": "boolean",
            "description": "Consentement requis ; vrai par défaut après découverte."
          }
        },
        "required": [
          "serverId",
          "name",
          "description",
          "inputSchema",
          "enabled",
          "requiresMandate"
        ]
      },
      "McpToolList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/McpTool"
            }
          },
          "discoveredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "items",
          "discoveredAt"
        ]
      },
      "McpToolPermission": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "requiresMandate": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled",
          "requiresMandate"
        ]
      },
      "ModelConfig": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "description": "Point d’accès compatible OpenAI (ex. https://api.groq.com/openai/v1)."
          },
          "protocol": {
            "type": "string",
            "enum": [
              "chat-completions",
              "responses"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "apiKeyRef": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,100}$",
            "description": "Nom de la variable d’environnement qui contient la clé. La clé ne transite jamais par l’API."
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "active": {
            "type": "boolean",
            "description": "Un seul modèle actif à la fois."
          }
        },
        "required": [
          "id",
          "label",
          "baseUrl",
          "protocol",
          "model",
          "apiKeyRef",
          "temperature",
          "active"
        ]
      },
      "ModelConfigPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelConfig"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Curseur opaque de la page suivante ; null en fin de liste."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "OperatorStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "reachable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "reachable"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "mcpServers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "reachable": {
                  "type": "boolean"
                },
                "toolCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "id",
                "name",
                "enabled",
                "reachable",
                "toolCount",
                "checkedAt"
              ]
            }
          },
          "administrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Administration"
            }
          }
        },
        "required": [
          "model",
          "mcpServers",
          "administrations"
        ]
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "LOGIN_REQUIRED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "IDEMPOTENCY_CONFLICT",
              "MANDATE_MISSING",
              "MANDATE_EXPIRED",
              "MANDATE_REVOKED",
              "MANDATE_SCOPE_DENIED",
              "REQUEST_INCOMPLETE",
              "INVALID_TRANSITION",
              "NOT_ASSISTED",
              "REPLAY_EXPIRED",
              "UNSUPPORTED_MEDIA_TYPE",
              "FILE_TOO_LARGE",
              "RATE_LIMITED",
              "UPSTREAM_UNAVAILABLE",
              "MCP_AUTH_FAILED",
              "MCP_CONNECTION_FAILED",
              "MCP_DISCOVERY_FAILED"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "traceId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "traceId"
        ]
      }
    }
  }
}
