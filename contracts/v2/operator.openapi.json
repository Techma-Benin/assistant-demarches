{
  "openapi": "3.1.0",
  "info": {
    "title": "Écran opérateur — Backend → Interface",
    "version": "2.2.0",
    "description": "Jeton Keycloak avec le rôle realm operator. Configuration globale du modèle et des serveurs MCP ; aucune donnée de dossier."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4010",
      "description": "Poste local (pnpm dev)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/operator/models": {
      "get": {
        "operationId": "listModels",
        "summary": "Lister les modèles",
        "tags": [
          "Opérateur"
        ],
        "parameters": [
          {
            "name": "traceparent",
            "in": "header",
            "required": false,
            "description": "W3C Trace Context. Facultatif : le serveur en crée un s’il est absent.",
            "schema": {
              "type": "string",
              "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-0[01]$"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Curseur opaque retourné par la page précédente.",
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Taille de page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succès.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelConfigPage"
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide (INVALID_REQUEST).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Authentification absente ou invalide (UNAUTHORIZED).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Droit insuffisant (FORBIDDEN).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Dépendance indisponible (UPSTREAM_UNAVAILABLE), avec Retry-After.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
