{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "test": {
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL"
      ]
    }
  }
}
