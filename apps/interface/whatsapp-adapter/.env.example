# Valeurs d’exemple uniquement : ne jamais committer de vraies valeurs.
PORT=4030
NODE_ENV=development
BACKEND_URL=http://127.0.0.1:4010

# Meta (WhatsApp Cloud API). En développement, sans META_ACCESS_TOKEN et
# META_PHONE_NUMBER_ID, l’envoi est simulé en mémoire (aucun appel réseau).
META_APP_SECRET=change-me
META_VERIFY_TOKEN=change-me
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0

# Au moins 32 caractères ; sert à calculer la clé d’abonné (jamais le numéro dans les journaux).
SUBJECT_HMAC_KEY=change-me-change-me-change-me-change-me

# Rappel Backend -> adaptateur (production uniquement)
CALLBACK_JWKS_URL=
CALLBACK_ISSUER=

# Jeton public de simulation, interdit en production.
MOCK_USER_TOKEN=mock-user

# Optionnel : dossier des contrats (par défaut contracts/v1 du dépôt).
# CONTRACTS_DIR=
