# Authentification (Keycloak, realm techma). `pnpm dev` à la racine injecte ces variables ;
# ne les renseigner à la main que pour lancer l'app seule. Valeurs factices.
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:4010
OIDC_ISSUER=http://127.0.0.1:8080/realms/techma
OIDC_CLIENT_ID=interface
OIDC_CLIENT_SECRET=change-me
# Fichier contenant 32 octets aléatoires en base64url (clé de chiffrement des cookies de session).
SESSION_SECRET_FILE=/chemin/vers/session.key
