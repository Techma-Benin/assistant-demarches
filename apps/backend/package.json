{
  "name": "@techma/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/apps/backend/src/main.js",
    "worker": "node dist/apps/backend/src/worker.js",
    "migrate": "node dist/apps/backend/src/cli.js migrate",
    "seed": "node dist/apps/backend/src/cli.js seed",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "test:groq": "node scripts/build.mjs && GROQ_LIVE_TEST=true node --test tests/groq.live.mjs",
    "test:live-model": "node scripts/build.mjs && RUN_LIVE_MODEL=1 node --test tests/live-model-replies.test.mjs",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@google-cloud/storage": "7.22.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bullmq": "5.81.5",
    "express": "5.1.0",
    "jose": "6.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-dist": "5.32.6",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
