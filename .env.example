BACKEND_URL=http://127.0.0.1:4010
TOOLING_URL=http://127.0.0.1:4030/mcp
# Jetons publics de simulation uniquement, jamais en production.
MOCK_USER_TOKEN=mock-user
MOCK_ADMIN_TOKEN=mock-admin

# Real Backend API and worker. No public mock tokens accepted.
# Provision a dedicated database; run migrations before starting the service.
DATABASE_URL=postgresql://techma:replace-me@127.0.0.1:5432/techma_backend
HOST=127.0.0.1
PORT=4010
OIDC_ISSUER=http://127.0.0.1:8080/realms/techma
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/techma/protocol/openid-connect/certs
MCP_ALLOWED_URLS=http://127.0.0.1:4030/mcp
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
DEFAULT_ADMINISTRATION_ID=demo-administration
IDENTITY_HMAC_KEY=replace-with-a-random-secret-of-at-least-32-characters
PUBLIC_BACKEND_URL=http://127.0.0.1:4010
REDIS_URL=redis://127.0.0.1:6380
QUEUE_PREFIX=techma-development

# The model provider name must match ModelConfig.provider.
# No model API calls are possible until a configured model and its secrets exist.
MODEL_PROVIDERS_JSON='{"openai":{"baseUrl":"https://api.openai.com/v1/","protocol":"responses","apiKeyEnv":"OPENAI_API_KEY","omitTemperature":true},"local":{"baseUrl":"http://127.0.0.1:8000/v1/","protocol":"chat-completions"}}'
OPENAI_API_KEY=

# Distinct service clients. Configure these in Keycloak with the contract audiences/scopes.
SERVICE_TOKEN_URL=http://127.0.0.1:8080/realms/techma/protocol/openid-connect/token
TOOLING_AGENT_CLIENT_SECRET=
TOOLING_CONTROL_CLIENT_SECRET=
WHATSAPP_DELIVERY_CLIENT_SECRET=
TOOLING_CONTROL_URL=http://127.0.0.1:4030
MCP_SECRET_REFERENCES='{}'
# ToolConfig.secretRef=backend-agent uses the dedicated agent client above.
# Other references explicitly map to environment variable names via MCP_SECRET_REFERENCES.

# Consent signing: provision a private RSA key locally; publish its public JWKS to Tooling.
# No key is generated or committed automatically.
MANDATE_SIGNING_KEY_FILE=
MANDATE_SIGNING_KEY_ID=techma-mandate-1
MANDATE_ISSUER=http://127.0.0.1:4010

# Static callback configured by the Interface team; never supplied by an end user.
WHATSAPP_CALLBACK_URL=

# File storage adapters: local (development), s3, or gcs.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIRECTORY=./.backend-files
STORAGE_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_REGION=us-east-1
# Set HOST=0.0.0.0 in a published environment. OIDC must use HTTPS there.
# PostgreSQL TLS configuration belongs in DATABASE_URL; no TLS checks are disabled.

# Opt-in local signed test identities for pnpm dev only (API must bind to loopback).
BACKEND_DEV_AUTH=false
