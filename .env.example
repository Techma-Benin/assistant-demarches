# Copier en .env à la racine. pnpm dev fournit toute la configuration locale (scripts/dev/local-config.mjs) ;
# seules les clés des fournisseurs externes sont à renseigner ici.

# Une seule clé. Sans précision, le fournisseur est Groq (llama-3.3-70b-versatile).
MODEL_API_KEY=
# MODEL_PROVIDER=groq
# openai gpt-4o-mini · openrouter openai/gpt-4o-mini · mistral mistral-small-latest
# deepseek deepseek-chat · gemini gemini-2.0-flash
# MODEL_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=llama-3.3-70b-versatile
# MODEL_PROTOCOL=chat-completions

# WhatsApp (module du Backend), seulement si un numéro Meta est configuré.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
