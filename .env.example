# Copier en .env à la racine, puis lancer `pnpm dev` (ou `pnpm dev backend`).
# Ce fichier ne contient que les secrets externes. Le reste est injecté par
# scripts/dev/local-config.mjs et ne doit pas être recopié ici :
#   PORT, PUBLIC_URL, DATABASE_URL, OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET,
#   SIGNING_KEY_FILE, FILE_STORAGE_DIR, TOOLING_URL, TOOLING_MCP_URL, XROAD_URL,
#   CORS_ORIGINS, MCP_ALLOWED_URLS
# Les mêmes adresses sont fournies à l'interface, au tooling et au X-Road simulé.

# Une seule clé. Sans précision, le fournisseur est Groq (llama-3.3-70b-versatile).
MODEL_API_KEY=
# MODEL_PROVIDER=groq
# openai gpt-4o-mini · openrouter openai/gpt-4o-mini · mistral mistral-small-latest
# deepseek deepseek-chat · gemini gemini-2.0-flash
# MODEL_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=llama-3.3-70b-versatile
# MODEL_PROTOCOL=chat-completions

# Transcription des vocaux : activée dès que MODEL_API_KEY (ou GROQ_API_KEY) est
# renseignée. Pas de TRANSCRIPTION_ENABLED (décision produit, utilisateur Billux).
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# WhatsApp, seulement si un numéro Meta est configuré.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
