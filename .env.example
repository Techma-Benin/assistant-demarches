# Copier en .env à la racine. pnpm dev fournit toute la configuration locale (scripts/dev/local-config.mjs) ;
# seules les clés des fournisseurs externes sont à renseigner ici.

# Une seule clé : elle choisit le fournisseur et son modèle par défaut.
# Groq llama-3.3-70b-versatile, OpenAI gpt-4o-mini, OpenRouter openai/gpt-4o-mini,
# Mistral mistral-small-latest, DeepSeek deepseek-chat, Gemini gemini-2.0-flash.
GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# Autre API compatible OpenAI : MODEL_API_KEY, MODEL_BASE_URL et MODEL_NAME.
# MODEL_NAME remplace le modèle par défaut du fournisseur choisi.
# MODEL_PROVIDER=groq|openai|openrouter|mistral|deepseek|gemini si plusieurs clés sont remplies.

# WhatsApp (module du Backend), seulement si un numéro Meta est configuré.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
