# Copier en .env à la racine. pnpm dev fournit toute la configuration locale (scripts/dev/local-config.mjs) ;
# seules les clés des fournisseurs externes sont à renseigner ici.

# Modèle d'IA et transcription des vocaux (Groq, format API OpenAI).
GROQ_API_KEY=

# WhatsApp (module du Backend), seulement si un numéro Meta est configuré.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
