{
  "name": "assistant-demarches",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:infra": "node scripts/dev.mjs --infra",
    "dev:reset": "node scripts/dev.mjs --reset",
    "dev:check": "node scripts/dev-check.mjs",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "contracts:generate": "node scripts/generate-types.mjs",
    "catalogue:import": "node scripts/import-service-public.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm contracts:check && pnpm contracts:generate && git diff --exit-code -- packages/contracts-ts/src && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "embedded-postgres": "18.6.0-beta.19",
    "openapi-typescript": "7.13.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  }
}
