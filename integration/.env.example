# Dépendances de integration/dependencies.compose.yml, réservées aux données fictives.
# Ce fichier est lu uniquement par dev:integration et test:integration après copie en .env.
INTEGRATION_DATABASE_URL=postgresql://integration:synthetic-local-test-only@127.0.0.1:5434/techma_integration_test
INTEGRATION_REDIS_URL=redis://127.0.0.1:6381
INTEGRATION_BACKEND_PORT=4110
INTEGRATION_TOOLING_PORT=4130
# Alternative sans Docker : omettre les deux URL, installer PostgreSQL et Redis,
# et préciser PG_BIN et REDIS_TEST_BINARY si leurs binaires ne sont pas trouvés.
